# Lines that start with # or // are comments
# Lines surrounded by /* */ are block comments

## Because I didn't want to install essentials
*:/gmc = >>>
  _checkStaff('mod');
  runas('~console', /gamemode creative player());
<<<
*:/gms = >>>
  _checkStaff('mod');
  @player = player(); 
  runas('~console', "/gamemode survival @player");
<<<
*:/gmsp = >>>
  _checkStaff('mod');
  @player = player(); 
  runas('~console', "/gamemode spectator @player");
<<<
*:/gma = >>>
  _checkStaff('mod');
  @player = player(); 
  runas('~console', "/gamemode adventure @player");
<<<
*:/gmop = >>>
  _checkStaff('admin');
  @player = player();
  @status = pinfo(@player, 8);
  if(@status == false) {
    runas('~console', "/op @player");
  } else { 
    runas('~console', "/deop @player");
  }
<<<

*:/buildteam [$player]= >>>
  if($player) {
    @player = $player
  }
  else {
    @player = player();
  }
  runas('~console', "/mv tp @player build");
  runas('~console', "/gamemode creative @player");
  runas('~console', "/lp user @player parent add buildteam");
  minimessage("<gray>[</gray><dark_green>GSNBot</dark_green><gray>]</gray> <gradient:#A5FB37:#CFFF45>Welcome to the build team @player</gradient>");
<<<

*:/c $ = >>>
  @player = player();
  @msg = $;
  runas('~console', "/say <@player> @msg");
<<<

*:/nv [$switch] = >>>
  @player = player();
  switch_ic($switch) {
    case 'ON':
      set_peffect(@player, 'NIGHT_VISION', 1, -1, 1, 0);
      #runas('~console', "/effect give @player minecraft:night_vision infinite");
      break();
    default:
      clear_peffects(@player)
      runas('~console', "/effect clear @player minecraft:night_vision");
  }
<<<

